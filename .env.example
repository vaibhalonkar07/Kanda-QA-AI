# Copy to .env and adjust
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./onion_qa.db
# PostgreSQL example: postgresql+psycopg2://user:pass@db:5432/onion_qa
VISION_BACKEND=classical        # classical | yolo
YOLO_MODEL_PATH=models/onion_seg.pt
PUBLIC_BASE_URL=http://localhost:8000
SEED_DEMO=true                  # creates demo users + default standard (turn off in production)
TOKEN_MINUTES=720
